# Public Firebase web-app configuration. No client secret or service-account key.
# Leave blank to keep Google sign-in inactive; all learning tools still work.
# Vite exposes only these four explicit client settings. Restart after editing.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# SERVER ONLY. Never add REACT_APP_ to these variables.
# Keep disabled until you select a model available on your Gemini free tier.
CHAT_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
