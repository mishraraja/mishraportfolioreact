{
  "name": "raja_mishra_portfolio",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^13.0.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-github-calendar": "^3.2.2",
    "react-icons": "^4.8.0",
    "react-router-dom": "^6.2.2",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@playwright/test": "^1.64.1",
    "cross-env": "^10.1.0"
  },
  "scripts": {
    "chat:index": "node scripts/gen-chat-index.cjs",
    "prestart": "npm run chat:index",
    "prebuild": "npm run chat:index",
    "test:chat": "node --test scripts/chat-api.test.cjs",
    "start": "react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "postbuild": "node scripts/gen-sitemap.mjs && node scripts/gen-offline.mjs && node scripts/check-budgets.mjs",
    "test:browser": "playwright test",
    "test:offline": "node --test scripts/offline-worker.test.cjs",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false --passWithNoTests",
    "eject": "react-scripts eject",
    "data:refresh": "node scripts/fetch-github.mjs",
    "sitemap": "node scripts/gen-sitemap.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
